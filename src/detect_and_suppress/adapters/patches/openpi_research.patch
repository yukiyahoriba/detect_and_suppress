+def _sae_apply_hook(xs, layer_idx, hook_config: dict[str, Any] | None):
+    if hook_config is None:
+        return xs, None
+    expert = int(_sae_cfg_get(hook_config, 'expert', 0))
+    x = xs[expert]
+    if x is None:
+        return xs, None
