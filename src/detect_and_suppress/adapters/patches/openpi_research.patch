+class SelfAttentionWithWeights(nn.Module):
+    """Self-attention compatible with Flax MHDPA params, plus CLS attention summary."""
+
+    num_heads: int = 12
+    dtype_mm: str = "float32"
+
+    @nn.compact
+    def __call__(self, x, *, return_cls_attention_summary=False):
+        features = x.shape[-1]
+        if features % self.num_heads != 0:
+            raise ValueError(f"features={features} must be divisible by num_heads={self.num_heads}.")
+        head_dim = features // self.num_heads
+        dense = lambda name: nn.DenseGeneral(
+            features=(self.num_heads, head_dim),
+            axis=-1,
+            dtype=self.dtype_mm,
+            kernel_init=nn.initializers.xavier_uniform(),
+            bias_init=nn.initializers.zeros_init(),
+            name=name,
+        )
+        query = dense("query")(x)
+        key = dense("key")(x)
+        value = dense("value")(x)
+
+        scale = jnp.sqrt(jnp.asarray(head_dim, dtype=query.dtype))
+        attn_weights = jnp.einsum("bqhd,bkhd->bhqk", query / scale, key)
+        attn_weights = jax.nn.softmax(attn_weights.astype(jnp.float32), axis=-1).astype(query.dtype)
+        attended = jnp.einsum("bhqk,bkhd->bqhd", attn_weights, value)
+        attended = nn.DenseGeneral(
+            features=features,
+            axis=(-2, -1),
+            dtype=self.dtype_mm,
+            kernel_init=nn.initializers.xavier_uniform(),
+            bias_init=nn.initializers.zeros_init(),
+            name="out",
+        )(attended)
+
+        cls_to_patches = None
+        if return_cls_attention_summary:
+            # Shape: [batch, patches]. Average heads for the CLS query, skipping CLS itself.
+            cls_to_patches = jnp.mean(attn_weights[:, :, 0, 1:], axis=1, dtype=jnp.float32)
+        return attended, cls_to_patches
+
