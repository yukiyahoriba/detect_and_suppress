+            return time >= -dt / 2
+
+        x_t, _ = jax.lax.while_loop(cond, step, (noise, 1.0))
+
+        attn_time = jnp.zeros((batch_size,), dtype=x_t.dtype)
+        suffix_tokens, suffix_mask, suffix_ar_mask, adarms_cond = self.embed_suffix(
+            observation, x_t, attn_time
+        )
+        suffix_attn_mask = make_attn_mask(suffix_mask, suffix_ar_mask)
+        prefix_to_suffix_mask = einops.repeat(prefix_mask, "b p -> b s p", s=suffix_tokens.shape[1])
+        full_attn_mask = jnp.concatenate([prefix_to_suffix_mask, suffix_attn_mask], axis=-1)
+        positions = jnp.sum(prefix_mask, axis=-1)[:, None] + jnp.cumsum(suffix_mask, axis=-1) - 1
+
+        (prefix_out, _), _, last_attn_summary = self.PaliGemma.llm(
+            [None, suffix_tokens],
+            mask=full_attn_mask,
+            positions=positions,
+            kv_cache=kv_cache,
+            adarms_cond=[None, adarms_cond],
+            return_attn_summary=True,
+        )
+        assert prefix_out is None
+
+        if last_attn_summary is None:
+            last_attn_summary = jnp.zeros((batch_size, prefix_token_count + self.action_horizon), dtype=jnp.float32)
+        action_to_prefix = last_attn_summary[:, :prefix_token_count]
+        action_to_image_tokens = {
+            key: action_to_prefix[:, start:min(end, prefix_token_count)] for key, (start, end) in image_token_ranges.items()
+        }
+        action_to_base = action_to_image_tokens[base_key]
+        action_to_wrist = (
+            action_to_image_tokens[wrist_key]
+            if wrist_key is not None
+            else jnp.zeros((batch_size, 0), dtype=action_to_prefix.dtype)
+        )
+        vision_cls_to_base = vision_cls_to_image_tokens.get(
+            base_key, jnp.zeros((batch_size, base_token_count), dtype=jnp.float32)
+        )
+        vision_cls_to_wrist = (
+            vision_cls_to_image_tokens.get(
+                wrist_key,
+                jnp.zeros((batch_size, image_token_counts.get(wrist_key, 0)), dtype=jnp.float32),
+            )
+            if wrist_key is not None
+            else jnp.zeros((batch_size, 0), dtype=jnp.float32)
+        )
+
+        extras = {
+            "attentions": {
+                "action_last_to_prefix": action_to_prefix,
+                "action_last_to_base_image": action_to_base,
+                "action_last_to_agent_image": action_to_base,
+                "action_last_to_wrist_image": action_to_wrist,
+                "action_last_to_left_wrist_image": action_to_wrist,
+                "action_last_to_image_tokens": action_to_image_tokens,
+                "vision_cls_to_base_image": vision_cls_to_base,
+                "vision_cls_to_agent_image": vision_cls_to_base,
+                "vision_cls_to_wrist_image": vision_cls_to_wrist,
+                "vision_cls_to_left_wrist_image": vision_cls_to_wrist,
+                "vision_cls_to_image_tokens": vision_cls_to_image_tokens,
+                "llm_prompt_last_attention_layers": jnp.asarray(
+                    tuple(int(layer) for layer in llm_prompt_to_image_tokens_by_layer), dtype=jnp.int32
+                ),
+                "llm_prompt_last_to_agent_image_by_layer": llm_prompt_to_base_by_layer,
+                "llm_prompt_last_to_base_image_by_layer": llm_prompt_to_base_by_layer,
+                "llm_prompt_last_to_wrist_image_by_layer": llm_prompt_to_wrist_by_layer,
+                "llm_prompt_last_to_left_wrist_image_by_layer": llm_prompt_to_wrist_by_layer,
+                "llm_prompt_last_to_image_tokens_by_layer": llm_prompt_to_image_tokens_by_layer,
+                "base_image_token_count": jnp.asarray(base_token_count, dtype=jnp.int32),
+                "prefix_token_count": jnp.asarray(prefix_token_count, dtype=jnp.int32),
+                "image_token_counts": {
+                    key: jnp.asarray(count, dtype=jnp.int32) for key, count in image_token_counts.items()
+                },
+            }
+        }
+        return x_t, extras
+
+    def sample_actions_with_sae(
+        self,
+        rng: at.KeyArrayLike,
+        observation: _model.Observation,
+        *,
+        layer: int = 5,
+        expert: int = 0,
+        pool: str = "mean",
+        direction=None,
+        mode: str | None = None,
+        alpha: float = 1.0,
+        num_steps: int | at.Int[at.Array, ""] = 10,
+        noise: at.Float[at.Array, "b ah ad"] | None = None,
+    ) -> tuple[_model.Actions, dict]:
+        """Sample actions while collecting or steering one residual-stream layer.
+
+        expert=0 targets PaliGemma, expert=1 targets the action expert. The returned
+        activations are from the final denoising pass and are mean-pooled by default.
+        """
+        observation = _model.preprocess_observation(None, observation, train=False)
+        dt = -1.0 / num_steps
+        batch_size = observation.state.shape[0]
+        if noise is None:
+            noise = jax.random.normal(rng, (batch_size, self.action_horizon, self.action_dim))
+
+        hook_config = {
+            "layer": layer,
+            "expert": expert,
+            "pool_mean": pool == "mean",
+            "direction": direction,
+            "mode": 1 if mode == "add" else 2 if mode == "ablate" else 0,
+            "alpha": alpha,
+        }
+        prefix_tokens, prefix_mask, prefix_ar_mask = self.embed_prefix(observation)
+        prefix_attn_mask = make_attn_mask(prefix_mask, prefix_ar_mask)
+        positions = jnp.cumsum(prefix_mask, axis=1) - 1
+        prefix_activations = None
+        if expert == 0:
+            _, kv_cache, prefix_activations = self.PaliGemma.llm(
+                [prefix_tokens, None],
+                mask=prefix_attn_mask,
+                positions=positions,
+                sae_hook_config=hook_config,
+            )
+        else:
+            _, kv_cache = self.PaliGemma.llm([prefix_tokens, None], mask=prefix_attn_mask, positions=positions)
+
+        def step(carry):
+            x_t, time = carry
+            suffix_tokens, suffix_mask, suffix_ar_mask, adarms_cond = self.embed_suffix(
+                observation, x_t, jnp.broadcast_to(time, batch_size)
+            )
+            suffix_attn_mask = make_attn_mask(suffix_mask, suffix_ar_mask)
+            prefix_attn_mask = einops.repeat(prefix_mask, "b p -> b s p", s=suffix_tokens.shape[1])
+            full_attn_mask = jnp.concatenate([prefix_attn_mask, suffix_attn_mask], axis=-1)
+            positions = jnp.sum(prefix_mask, axis=-1)[:, None] + jnp.cumsum(suffix_mask, axis=-1) - 1
+            (prefix_out, suffix_out), _ = self.PaliGemma.llm(
+                [None, suffix_tokens],
+                mask=full_attn_mask,
+                positions=positions,
+                kv_cache=kv_cache,
+                adarms_cond=[None, adarms_cond],
+            )
+            assert prefix_out is None
+            v_t = self.action_out_proj(suffix_out[:, -self.action_horizon :])
+            return x_t + dt * v_t, time + dt
+
+        def cond(carry):
+            _, time = carry
+            return time >= -dt / 2
+
+        x_t, _ = jax.lax.while_loop(cond, step, (noise, 1.0))
+        suffix_tokens, suffix_mask, suffix_ar_mask, adarms_cond = self.embed_suffix(
+            observation, x_t, jnp.zeros((batch_size,), dtype=x_t.dtype)
+        )
+        suffix_attn_mask = make_attn_mask(suffix_mask, suffix_ar_mask)
+        prefix_attn_mask = einops.repeat(prefix_mask, "b p -> b s p", s=suffix_tokens.shape[1])
+        full_attn_mask = jnp.concatenate([prefix_attn_mask, suffix_attn_mask], axis=-1)
+        positions = jnp.sum(prefix_mask, axis=-1)[:, None] + jnp.cumsum(suffix_mask, axis=-1) - 1
+        (prefix_out, suffix_out), _, activations = self.PaliGemma.llm(
+            [None, suffix_tokens],
+            mask=full_attn_mask,
+            positions=positions,
+            kv_cache=kv_cache,
+            adarms_cond=[None, adarms_cond],
+            sae_hook_config=hook_config,
+        )
+        assert prefix_out is None
+        v_t = self.action_out_proj(suffix_out[:, -self.action_horizon :])
+        selected_source = prefix_activations if expert == 0 else activations
+        selected = selected_source[layer] if selected_source is not None else None
+        return x_t + dt * v_t, {"sae": {"activations": selected, "all_layer_activations": activations, "layer": layer, "expert": expert, "pool": pool}}
+
+    def sample_actions_with_sae_steering(
+        self,
+        rng: at.KeyArrayLike,
+        observation: _model.Observation,
+        *,
+        layer: int = 5,
+        expert: int = 0,
+        direction=None,
+        mode_id: int = 1,
+        alpha: float = 1.0,
+        num_steps: int | at.Int[at.Array, ""] = 10,
+        noise: at.Float[at.Array, "b ah ad"] | None = None,
+    ) -> _model.Actions:
+        """Sample actions with paper-style SAE residual-stream intervention.
+
+        This path recomputes the full prefix+suffix sequence at every flow-matching
+        denoising step, so a hooked PaliGemma layer is actually present at every
+        iteration rather than only in the prefix KV-cache prefill.
+        """
+        observation = _model.preprocess_observation(None, observation, train=False)
+        dt = -1.0 / num_steps
+        batch_size = observation.state.shape[0]
+        if noise is None:
+            noise = jax.random.normal(rng, (batch_size, self.action_horizon, self.action_dim))
+
+        hook_config = {
+            "layer": layer,
+            "expert": expert,
+            "pool_mean": True,
+            "direction": direction,
+            "mode": mode_id,
+            "alpha": alpha,
+        }
+        prefix_tokens, prefix_mask, prefix_ar_mask = self.embed_prefix(observation)
+
+        def step(carry):
+            x_t, time = carry
+            suffix_tokens, suffix_mask, suffix_ar_mask, adarms_cond = self.embed_suffix(
+                observation, x_t, jnp.broadcast_to(time, batch_size)
+            )
+            input_mask = jnp.concatenate([prefix_mask, suffix_mask], axis=1)
+            ar_mask = jnp.concatenate([prefix_ar_mask, suffix_ar_mask], axis=0)
+            attn_mask = make_attn_mask(input_mask, ar_mask)
+            positions = jnp.cumsum(input_mask, axis=1) - 1
+            (_, suffix_out), _, _ = self.PaliGemma.llm(
+                [prefix_tokens, suffix_tokens],
+                mask=attn_mask,
+                positions=positions,
+                adarms_cond=[None, adarms_cond],
+                sae_hook_config=hook_config,
+            )
+            v_t = self.action_out_proj(suffix_out[:, -self.action_horizon :])
+            return x_t + dt * v_t, time + dt
+
+        def cond(carry):
+            _, time = carry
+            return time >= -dt / 2
+
+        x_0, _ = jax.lax.while_loop(cond, step, (noise, 1.0))
+        return x_0
+
+
+    def sample_actions_with_sae_steering_and_activation(
+        self,
+        rng: at.KeyArrayLike,
+        observation: _model.Observation,
+        *,
+        layer: int = 5,
+        expert: int = 0,
+        direction=None,
+        mode_id: int = 2,
+        alpha: float = 1.0,
+        intervention_active: bool | at.Bool[at.Array, ""] = True,
+        num_steps: int | at.Int[at.Array, ""] = 10,
+        noise: at.Float[at.Array, "b ah ad"] | None = None,
+    ) -> tuple[_model.Actions, dict]:
+        """Apply paper-style steering and return the final hooked pre-intervention activation.
+
+        The intervention is applied to every token at the selected residual-stream
+        layer for every action-expert flow-matching denoising iteration. The returned
+        activation is measured immediately before that intervention on the final
+        iteration that produced an executed action chunk.
+        """
+        if direction is None:
+            raise ValueError("direction is required for SAE steering")
+        observation = _model.preprocess_observation(None, observation, train=False)
+        dt = -1.0 / num_steps
+        batch_size = observation.state.shape[0]
+        if noise is None:
+            noise = jax.random.normal(rng, (batch_size, self.action_horizon, self.action_dim))
+
+        hook_config = {
+            "layer": layer,
+            "expert": expert,
+            "pool_mean": True,
+            "direction": direction,
+            "mode": mode_id,
+            "alpha": alpha,
+            "intervention_active": intervention_active,
+        }
+        prefix_tokens, prefix_mask, prefix_ar_mask = self.embed_prefix(observation)
+        activation_dim = len(direction)
+        initial_activation = jnp.zeros((batch_size, activation_dim), dtype=prefix_tokens.dtype)
+
+        def step(carry):
+            x_t, time, _ = carry
+            suffix_tokens, suffix_mask, suffix_ar_mask, adarms_cond = self.embed_suffix(
+                observation, x_t, jnp.broadcast_to(time, batch_size)
+            )
+            input_mask = jnp.concatenate([prefix_mask, suffix_mask], axis=1)
+            ar_mask = jnp.concatenate([prefix_ar_mask, suffix_ar_mask], axis=0)
+            attn_mask = make_attn_mask(input_mask, ar_mask)
+            positions = jnp.cumsum(input_mask, axis=1) - 1
+            (_, suffix_out), _, all_activations = self.PaliGemma.llm(
+                [prefix_tokens, suffix_tokens],
+                mask=attn_mask,
+                positions=positions,
+                adarms_cond=[None, adarms_cond],
+                sae_hook_config=hook_config,
+            )
+            v_t = self.action_out_proj(suffix_out[:, -self.action_horizon :])
+            return x_t + dt * v_t, time + dt, all_activations[layer]
+
+        def cond(carry):
+            _, time, _ = carry
+            return time >= -dt / 2
+
+        x_0, _, activation = jax.lax.while_loop(cond, step, (noise, 1.0, initial_activation))
+        return x_0, {"sae": {"activations": activation, "layer": layer, "expert": expert}}
+
+    def sample_actions_with_vit_probe_gated_sae_steering(
+        self,
+        rng: at.KeyArrayLike,
+        observation: _model.Observation,
+        detector_mean: at.Float[at.Array, "d"],
+        detector_scale: at.Float[at.Array, "d"],
+        detector_coef: at.Float[at.Array, "d"],
+        detector_intercept: at.Float[at.Array, ""],
+        detector_threshold: at.Float[at.Array, ""],
+        *,
+        detector_layer: int = 17,
+        layer: int = 5,
+        expert: int = 0,
+        direction=None,
+        mode_id: int = 3,
+        alpha: float = 1.0,
+        num_steps: int | at.Int[at.Array, ""] = 10,
+        noise: at.Float[at.Array, "b ah ad"] | None = None,
+    ) -> tuple[_model.Actions, dict]:
+        """Detect from a ViT post-block residual and gate PG SAE steering in one forward."""
+        if direction is None:
+            raise ValueError("direction is required for SAE steering")
+        if detector_layer < 0 or detector_layer >= 27:
+            raise ValueError("detector_layer must be a SigLIP layer in [0, 26]")
+        observation = _model.preprocess_observation(None, observation, train=False)
+        dt = -1.0 / num_steps
+        batch_size = observation.state.shape[0]
+        if noise is None:
+            noise = jax.random.normal(rng, (batch_size, self.action_horizon, self.action_dim))
+
+        input_mask = []
+        ar_mask = []
+        tokens = []
+        detector_activation = None
+        for name in observation.images:
+            image_tokens, details = self.PaliGemma.img(observation.images[name], train=False)
+            tokens.append(image_tokens)
+            input_mask.append(einops.repeat(observation.image_masks[name], "b -> b s", s=image_tokens.shape[1]))
+            ar_mask += [False] * image_tokens.shape[1]
+            if name == "base_0_rgb":
+                detector_activation = jnp.mean(
+                    details["encoder"][f"block{detector_layer:02d}"]["+mlp"], axis=1, dtype=jnp.float32
+                )
+        if detector_activation is None:
+            raise ValueError("base_0_rgb is required for the ViT detector")
+        if observation.tokenized_prompt is not None:
+            tokenized_inputs = self.PaliGemma.llm(observation.tokenized_prompt, method="embed")
+            tokens.append(tokenized_inputs)
+            input_mask.append(observation.tokenized_prompt_mask)
+            ar_mask += [False] * tokenized_inputs.shape[1]
+        prefix_tokens = jnp.concatenate(tokens, axis=1)
+        prefix_mask = jnp.concatenate(input_mask, axis=1)
+        prefix_ar_mask = jnp.asarray(ar_mask)
+
+        detector_score = (
+            ((detector_activation - detector_mean) / detector_scale) @ detector_coef + detector_intercept
+        )
+        detected = detector_score > detector_threshold
+        hook_config = {
+            "layer": layer,
+            "expert": expert,
+            "pool_mean": True,
+            "direction": direction,
+            "mode": mode_id,
+            "alpha": alpha,
+            "intervention_active": detected[:, None, None],
+        }
+        prefix_attn_mask = make_attn_mask(prefix_mask, prefix_ar_mask)
+        positions = jnp.cumsum(prefix_mask, axis=1) - 1
+        _, kv_cache, _ = self.PaliGemma.llm(
+            [prefix_tokens, None],
+            mask=prefix_attn_mask,
+            positions=positions,
+            sae_hook_config=hook_config,
+        )
+
+        def step(carry):
+            x_t, time = carry
+            suffix_tokens, suffix_mask, suffix_ar_mask, adarms_cond = self.embed_suffix(
+                observation, x_t, jnp.broadcast_to(time, batch_size)
+            )
+            suffix_attn_mask = make_attn_mask(suffix_mask, suffix_ar_mask)
+            cached_prefix_mask = einops.repeat(prefix_mask, "b p -> b s p", s=suffix_tokens.shape[1])
+            full_attn_mask = jnp.concatenate([cached_prefix_mask, suffix_attn_mask], axis=-1)
+            suffix_positions = jnp.sum(prefix_mask, axis=-1)[:, None] + jnp.cumsum(suffix_mask, axis=-1) - 1
+            (prefix_out, suffix_out), _ = self.PaliGemma.llm(
+                [None, suffix_tokens],
+                mask=full_attn_mask,
+                positions=suffix_positions,
+                kv_cache=kv_cache,
+                adarms_cond=[None, adarms_cond],
+            )
+            assert prefix_out is None
+            v_t = self.action_out_proj(suffix_out[:, -self.action_horizon :])
+            return x_t + dt * v_t, time + dt
+
+        def cond(carry):
+            _, time = carry
+            return time >= -dt / 2
+
+        x_0, _ = jax.lax.while_loop(cond, step, (noise, 1.0))
+        return x_0, {
+            "probe": {
+                "score": detector_score,
+                "detected": detected,
+                "threshold": detector_threshold,
+                "layer": detector_layer,
+            }
+        }
+
+    def sample_actions_with_probe_gated_sae_steering(
+        self,
+        rng: at.KeyArrayLike,
+        observation: _model.Observation,
+        detector_mean: at.Float[at.Array, "d"],
+        detector_scale: at.Float[at.Array, "d"],
+        detector_coef: at.Float[at.Array, "d"],
+        detector_intercept: at.Float[at.Array, ""],
+        detector_threshold: at.Float[at.Array, ""],
+        *,
+        detector_layer: int = 0,
+        layer: int = 5,
+        expert: int = 0,
+        direction=None,
+        mode_id: int = 3,
+        alpha: float = 1.0,
+        num_steps: int | at.Int[at.Array, ""] = 10,
+        noise: at.Float[at.Array, "b ah ad"] | None = None,
+    ) -> tuple[_model.Actions, dict]:
+        """Probe a PG residual stream and gate an SAE intervention in the same prefix forward."""
+        if direction is None:
+            raise ValueError("direction is required for SAE steering")
+        if not 0 <= detector_layer <= layer < 18 or expert != 0:
+            raise ValueError("PG steering requires 0 <= detector_layer <= layer < 18 and expert=0")
+        observation = _model.preprocess_observation(None, observation, train=False)
+        dt = -1.0 / num_steps
+        batch_size = observation.state.shape[0]
+        if noise is None:
+            noise = jax.random.normal(rng, (batch_size, self.action_horizon, self.action_dim))
+
+        prefix_tokens, prefix_mask, prefix_ar_mask = self.embed_prefix(observation)
+        if detector_layer == 0:
+            # The layer-0 collection hook records this exact unmasked token mean at block input.
+            detector_activation = jnp.mean(prefix_tokens, axis=1).astype(jnp.float32)
+            detector_score = (
+                ((detector_activation - detector_mean) / detector_scale) @ detector_coef + detector_intercept
+            )
+            detected = detector_score > detector_threshold
+            detector_hook_config = {}
+            intervention_active = detected[:, None, None]
+        else:
+            detector_hook_config = {
+                "detector_layer": detector_layer,
+                "detector_mean": detector_mean,
+                "detector_scale": detector_scale,
+                "detector_coef": detector_coef,
+                "detector_intercept": detector_intercept,
+                "detector_threshold": detector_threshold,
+            }
+            intervention_active = jnp.asarray(False, dtype=jnp.bool_)
+        hook_config = {
+            "layer": layer,
+            "expert": expert,
+            "pool_mean": True,
+            "direction": direction,
+            "mode": mode_id,
+            "alpha": alpha,
+            "intervention_active": intervention_active,
+            **detector_hook_config,
+        }
+
+        prefix_attn_mask = make_attn_mask(prefix_mask, prefix_ar_mask)
+        positions = jnp.cumsum(prefix_mask, axis=1) - 1
+        _, kv_cache, all_activations = self.PaliGemma.llm(
+            [prefix_tokens, None],
+            mask=prefix_attn_mask,
+            positions=positions,
+            sae_hook_config=hook_config,
+        )
+        if detector_layer != 0:
+            detector_activation = all_activations[detector_layer].astype(jnp.float32)
+            detector_score = (
+                ((detector_activation - detector_mean) / detector_scale) @ detector_coef + detector_intercept
+            )
+            detected = detector_score > detector_threshold
+
+        def step(carry):
+            x_t, time = carry
+            suffix_tokens, suffix_mask, suffix_ar_mask, adarms_cond = self.embed_suffix(
+                observation, x_t, jnp.broadcast_to(time, batch_size)
+            )
+            suffix_attn_mask = make_attn_mask(suffix_mask, suffix_ar_mask)
+            prefix_attn_mask = einops.repeat(prefix_mask, "b p -> b s p", s=suffix_tokens.shape[1])
+            full_attn_mask = jnp.concatenate([prefix_attn_mask, suffix_attn_mask], axis=-1)
+            positions = jnp.sum(prefix_mask, axis=-1)[:, None] + jnp.cumsum(suffix_mask, axis=-1) - 1
+            (prefix_out, suffix_out), _ = self.PaliGemma.llm(
+                [None, suffix_tokens],
+                mask=full_attn_mask,
+                positions=positions,
+                kv_cache=kv_cache,
+                adarms_cond=[None, adarms_cond],
+            )
+            assert prefix_out is None
+            v_t = self.action_out_proj(suffix_out[:, -self.action_horizon :])
+            return x_t + dt * v_t, time + dt
+
+        def cond(carry):
+            _, time = carry
+            return time >= -dt / 2
+
+        x_0, _ = jax.lax.while_loop(cond, step, (noise, 1.0))
+        return x_0, {
+            "probe": {
+                "score": detector_score,
