+    direction = _sae_cfg_get(hook_config, 'direction')
+    mode = _sae_cfg_get(hook_config, 'mode')
+    if direction is not None and mode is not None:
+        is_target = layer_idx == int(_sae_cfg_get(hook_config, 'layer', -1))
+        intervention_active = jnp.asarray(_sae_cfg_get(hook_config, 'intervention_active', True), dtype=jnp.bool_)
+        detector_mean = _sae_cfg_get(hook_config, "detector_mean")
+        if detector_mean is not None:
+            detector_scale = jnp.asarray(_sae_cfg_get(hook_config, "detector_scale"), dtype=jnp.float32)
+            detector_coef = jnp.asarray(_sae_cfg_get(hook_config, "detector_coef"), dtype=jnp.float32)
+            detector_intercept = jnp.asarray(_sae_cfg_get(hook_config, "detector_intercept"), dtype=jnp.float32)
+            detector_threshold = jnp.asarray(_sae_cfg_get(hook_config, "detector_threshold"), dtype=jnp.float32)
+            detector_activation = activations.astype(jnp.float32)
+            detector_score = (
+                (detector_activation - jnp.asarray(detector_mean, dtype=jnp.float32)) / detector_scale
+            ) @ detector_coef + detector_intercept
+            detected_here = (detector_score > detector_threshold)[:, None, None]
+            detector_layer = int(_sae_cfg_get(hook_config, "detector_layer", -1))
+            intervention_active = jnp.where(layer_idx == detector_layer, detected_here, intervention_active)
+        v = jnp.asarray(direction, dtype=x.dtype)
+        v = v / jnp.maximum(jnp.linalg.norm(v), 1e-8)
+        if mode == 1:
+            steered = x + float(_sae_cfg_get(hook_config, 'alpha', 1.0)) * v
+        elif mode == 2:
+            steered = x - jnp.sum(x * v, axis=-1, keepdims=True) * v
+        elif mode == 3:
+            hidden_norm = jnp.linalg.norm(x.astype(jnp.float32), axis=-1, keepdims=True).astype(x.dtype)
+            steered = x - float(_sae_cfg_get(hook_config, 'alpha', 1.0)) * hidden_norm * v
+        else:
