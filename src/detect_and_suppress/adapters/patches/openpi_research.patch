+    def extract_patch_probe_residuals(
+        self,
+        observation: _model.Observation,
+        *,
+        llm_layers: tuple[int, ...] = (0, 5, 11, 17),
+        vit_layers: tuple[int, ...] = (0, 8, 17, 26),
+        image_keys: tuple[str, ...] = ("base_0_rgb",),
+    ) -> dict[str, at.Float[at.Array, "b l d"]]:
+        """Extract mean-pooled ViT and PaliGemma residuals in one prefix forward."""
+        observation = _model.preprocess_observation(None, observation, train=False)
+        if not llm_layers or any(layer < 0 or layer >= 18 for layer in llm_layers):
+            raise ValueError(f"LLM layers must be in [0, 17], got {llm_layers}")
+        if not vit_layers or any(layer < 0 or layer >= 27 for layer in vit_layers):
+            raise ValueError(f"ViT layers must be in [0, 26], got {vit_layers}")
+        missing = set(image_keys).difference(observation.images)
+        if missing:
+            raise ValueError(f"Missing requested image keys: {sorted(missing)}")
+
+        tokens = []
+        input_masks = []
+        ar_mask = []
