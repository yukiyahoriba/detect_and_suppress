+@dataclass
+class _PatchEpisode:
+    patch: Image.Image
+    position: tuple[int, int]
+    angle: float
+    shx: float
+    shy: float
+    scale: float
+
+
+def _compute_patch_position(
+    placement_mode: str,
+    img_shape: tuple[int, int],
+    patch_shape: tuple[int, int],
+    default_xy: tuple[int, int],
+    rng: random.Random,
+) -> tuple[int, int]:
+    img_h, img_w = img_shape
+    patch_h, patch_w = patch_shape
+    max_x = max(img_w - patch_w, 0)
+    max_y = max(img_h - patch_h, 0)
+    placement_mode = (placement_mode or "preset").lower()
+
+    if placement_mode == "random":
+        x = rng.randint(0, max_x) if max_x > 0 else 0
+        y = rng.randint(0, max_y) if max_y > 0 else 0
+    elif placement_mode == "top_left":
+        x, y = 0, 0
+    elif placement_mode == "top_right":
+        x, y = max_x, 0
+    elif placement_mode == "bottom_left":
+        x, y = 0, max_y
+    elif placement_mode == "bottom_right":
+        x, y = max_x, max_y
+    elif placement_mode == "center":
+        x = max((img_w - patch_w) // 2, 0)
+        y = max((img_h - patch_h) // 2, 0)
+    else:
+        x = default_xy[0] if default_xy is not None else 0
+        y = default_xy[1] if default_xy is not None else 0
+        x = min(max(x, 0), max_x)
+        y = min(max(y, 0), max_y)
+    return int(x), int(y)
+
+
+def _affine_coeffs(angle_deg: float, shx: float, shy: float, center: tuple[float, float]) -> tuple[float, ...]:
+    angle = math.radians(angle_deg)
+    cos_a = math.cos(angle)
+    sin_a = math.sin(angle)
+    rot = np.array([[cos_a, -sin_a], [sin_a, cos_a]], dtype=float)
+    shear = np.array([[1.0, shx], [shy, 1.0]], dtype=float)
+    mat = shear @ rot
+    cx, cy = center
+    transform = np.array(
+        [
+            [mat[0, 0], mat[0, 1], cx - mat[0, 0] * cx - mat[0, 1] * cy],
+            [mat[1, 0], mat[1, 1], cy - mat[1, 0] * cx - mat[1, 1] * cy],
+            [0.0, 0.0, 1.0],
+        ],
+        dtype=float,
+    )
+    inv = np.linalg.inv(transform)
+    return (
+        float(inv[0, 0]),
+        float(inv[0, 1]),
+        float(inv[0, 2]),
+        float(inv[1, 0]),
+        float(inv[1, 1]),
+        float(inv[1, 2]),
+    )
+
+
+def _normalize_patch_size(
+    patch_size: tuple[int, int] | None,
+    default_size: tuple[int, int],
+) -> tuple[int, int]:
+    if patch_size is None:
+        return default_size
+    if patch_size[0] <= 0 or patch_size[1] <= 0:
+        return default_size
+    return patch_size
+
+
+def _token_tile_size(img_shape: tuple[int, int], token_grid_size: int) -> tuple[int, int]:
+    img_h, img_w = img_shape
+    grid = max(int(token_grid_size), 1)
+    return max(1, img_w // grid), max(1, img_h // grid)
+
+
+def _snap_patch_position_to_grid(
+    position: tuple[int, int],
+    img_shape: tuple[int, int],
+    patch_shape: tuple[int, int],
+    token_grid_size: int,
+) -> tuple[int, int]:
+    img_h, img_w = img_shape
+    patch_h, patch_w = patch_shape
+    step_w, step_h = _token_tile_size((img_h, img_w), token_grid_size)
+
+    x, y = int(position[0]), int(position[1])
+    x = int(round(x / step_w) * step_w) if step_w > 0 else x
+    y = int(round(y / step_h) * step_h) if step_h > 0 else y
+
+    max_x = max(img_w - patch_w, 0)
+    max_y = max(img_h - patch_h, 0)
+    x = min(max(x, 0), max_x)
+    y = min(max(y, 0), max_y)
+    return x, y
+
